{
  "name": "@videoeditor/schema",
  "private": true,
  "version": "0.1.0",
  "description": "Shared Zod schemas + TypeScript types for timeline state, edit events, and editing preferences. Consumed by the editor app and any external tooling that reads/writes the same JSON artifacts.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./timeline": {
      "types": "./src/timeline.ts",
      "import": "./src/timeline.ts"
    },
    "./diff-event": {
      "types": "./src/diff-event.ts",
      "import": "./src/diff-event.ts"
    },
    "./editing-preferences": {
      "types": "./src/editing-preferences.ts",
      "import": "./src/editing-preferences.ts"
    }
  },
  "dependencies": {
    "zod": "4.0.9"
  },
  "license": "SEE LICENSE IN ../../LICENSE.md"
}
